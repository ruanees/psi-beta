# Copie para .env.local. NEXT_PUBLIC_* é variável de BUILD: é colada no bundle.
# No painel da Cloudflare ela vai em "Build variables", não em "Variables" de runtime.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Opcional: endereço do backoffice. Com ele, quem opera a plataforma escolhe o contexto ao entrar.
NEXT_PUBLIC_BACKOFFICE_URL=http://localhost:3100
