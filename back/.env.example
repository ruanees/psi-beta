# Copie para .env para rodar local (npm run dev). Nunca versione o .env.
# URL e chave anon são públicas por design; em produção ficam no wrangler.toml.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=cole-a-chave-anon-aqui
# Só se o projeto ainda assina JWT com HS256 (projetos antigos). Projetos novos usam JWKS.
SUPABASE_JWT_SECRET=
ORIGENS=http://localhost:3000
FRONT_URL=http://localhost:3000
PORT=3001
