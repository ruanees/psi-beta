{
  "name": "psi-back",
  "private": true,
  "version": "0.0.0",
  "description": "BFF do PSI: NestJS no Cloudflare Workers, Supabase atrás",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "npm run build && node --env-file-if-exists=.env dist/src/main.js",
    "openapi": "npm run build && node dist/scripts/openapi.js",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "bundle": "wrangler deploy --dry-run --outdir .wrangler/bundle --env=\"\"",
    "deploy": "wrangler deploy --env=\"\"",
    "deploy:producao": "wrangler deploy --env producao",
    "db:test": "supabase test db"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@supabase/supabase-js": "2.117.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "express": "5.3.0",
    "jose": "6.2.12",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "supabase": "2.121.0",
    "typescript": "5.9.3",
    "wrangler": "4.151.0"
  }
}
